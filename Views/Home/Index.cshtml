@{
    ViewData["Title"] = "Book Store";
}

<nav class="navbar">
    <h2>📚 Book Store</h2>

    <input type="text" id="search" placeholder="Search books...">

    <div>
        ❤️ Wishlist: <span id="wish-count">0</span>
        🛒 Cart: <span id="cart-count">0</span>

        <button onclick="toggleDark()">🌙</button>
    </div>
</nav>

